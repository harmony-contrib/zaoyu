{
  "app": {
    "products": [
      {
        "name": "default",
        "bundleName": "com.richerfu.nodune",
        "vendor": "richerfu",
        "label": "$string:nodune_name",
        "icon": "$media:nodune_icon",
        "compatibleSdkVersion": "6.0.2(22)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
