          ]
        }
      ]
    },
    {
      "name": "nodune",
      "srcPath": "./entries/nodune",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "nodune"
          ]
        }
      ]
    },
    {
      "name": "pixrune",
      "srcPath": "./entries/pixrune",
